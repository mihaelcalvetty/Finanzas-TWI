# ============================================================
# Finanzas-TWI — Variables de Entorno (EJEMPLO)
# ============================================================
# 1. Copia este archivo como .env en la raíz del repositorio
#    cp .env.example .env
# 2. Completa los valores reales. El .env está en .gitignore —
#    NUNCA lo subas a Git.
# ============================================================

# ----------------------------------------------------------
# Docker Hub (Release)
# ----------------------------------------------------------
# Imagen a descargar en docker-compose.release.yml
DOCKER_IMAGE=leonardocaceres/finanzasbeof:v1.0.0

# Release local multi-instancia (independiente de la imagen publicada)
RELEASE_IMAGE=finanzas-twi-release:local
RELEASE_FRONTEND_PORT=3001
RELEASE_DB_PORT=5433

# ----------------------------------------------------------
# Puertos (Docker Compose)
# ----------------------------------------------------------
# Puerto expuesto en el host para la API en desarrollo (por defecto: 5000)
API_PORT=5000
# Puerto expuesto en el host para el frontend en desarrollo (por defecto: 3000)
FRONTEND_PORT=3000
# URL de la API que consumirá el navegador desde el frontend
API_URL=http://localhost:5000

# ----------------------------------------------------------
# Base de datos PostgreSQL
# ----------------------------------------------------------
# Para Docker Compose usa Host=db (nombre del servicio)
# Para desarrollo local usa Host=localhost
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=finanzas_db;Username=postgres;Password=CAMBIAR_AQUI

# Contraseña del usuario postgres (usada también por el servicio 'db' en Compose)
DB_PASSWORD=CAMBIAR_AQUI

# ----------------------------------------------------------
# Docker / Comportamiento HTTP
# ----------------------------------------------------------
# Deshabilita la redirección HTTPS (obligatorio en contenedores sin TLS)
DISABLE_HTTPS_REDIRECTION=true

# Activa el modo de cookies HTTP-safe (SameSite=Lax, Secure=SameAsRequest)
USE_HTTP_COOKIES=true

# Ruta donde se persisten las claves de Data Protection
# (debe coincidir con el volumen montado en docker-compose)
DATA_PROTECTION_KEYS_PATH=/app/dataprotection-keys

# Orígenes CORS permitidos (separados por coma, sin espacios)
# Dev local y Docker:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:5500
# Docker release (añadir puertos 5001-5004 en Punto 7):
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004

# ----------------------------------------------------------
# OAuth — Dropbox  ✅ (único proveedor habilitado para pruebas reales)
# ----------------------------------------------------------
# Registrar en: https://www.dropbox.com/developers/apps
# Redirect URIs a agregar en la consola Dropbox:
#   http://localhost:5000/auth/dropbox/callback   <- Docker dev (backend en puerto 5000)
#   https://localhost:7133/auth/dropbox/callback  <- dotnet run local
Authentication__Dropbox__ClientId=
Authentication__Dropbox__ClientSecret=
Authentication__Dropbox__CallbackPath=/auth/dropbox/callback

# ----------------------------------------------------------
# OAuth — Google  ⏳ (pendiente: agregar credenciales cuando disponibles)
# ----------------------------------------------------------
# Registrar en: https://console.cloud.google.com/
# Redirect URI: http://localhost:5000/api/auth/google/callback
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Google__CallbackPath=/api/auth/google/callback

# ----------------------------------------------------------
# OAuth — Discord  ⏳ (pendiente: agregar credenciales cuando disponibles)
# ----------------------------------------------------------
# Registrar en: https://discord.com/developers/applications
# Redirect URI: http://localhost:5000/api/auth/discord/callback
Authentication__Discord__ClientId=
Authentication__Discord__ClientSecret=
Authentication__Discord__CallbackPath=/api/auth/discord/callback

# ----------------------------------------------------------
# OAuth — Twitch  ⏳ (pendiente: agregar credenciales cuando disponibles)
# ----------------------------------------------------------
# Registrar en: https://dev.twitch.tv/console/apps
# Redirect URI: http://localhost:5000/signin-twitch
Authentication__Twitch__ClientId=
Authentication__Twitch__ClientSecret=
Authentication__Twitch__CallbackPath=/signin-twitch

# ----------------------------------------------------------
# OAuth — Spotify  ⏳ (pendiente: agregar credenciales cuando disponibles)
# ----------------------------------------------------------
# Registrar en: https://developer.spotify.com/dashboard
# Redirect URI: http://localhost:5000/signin-spotify
Authentication__Spotify__ClientId=
Authentication__Spotify__ClientSecret=
Authentication__Spotify__CallbackPath=/signin-spotify

# ----------------------------------------------------------
# OAuth — Microsoft  ⏳ (pendiente: agregar credenciales cuando disponibles)
# ----------------------------------------------------------
# Registrar en: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Redirect URI: http://localhost:5000/auth/microsoft/callback
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Authentication__Microsoft__TenantId=common
Authentication__Microsoft__CallbackPath=/auth/microsoft/callback

# ----------------------------------------------------------
# OAuth 2.0 — X (Twitter), cliente Web App confidencial + PKCE
# ----------------------------------------------------------
# Client ID/Secret OAuth 2.0; NO API Key/Secret OAuth 1.0a ni Bearer Token.
# Registrar en https://console.x.com (o https://developer.x.com)
# Callback Docker dev: http://localhost:5000/api/auth/x/callback
# Callback HTTPS local: https://localhost:7133/api/auth/x/callback
Authentication__X__ClientId=
Authentication__X__ClientSecret=
Authentication__X__CallbackPath=/api/auth/x/callback

# Slack Sign in with Slack (OpenID Connect); registrar un callback HTTPS.
Authentication__Slack__ClientId=
Authentication__Slack__ClientSecret=
Authentication__Slack__CallbackPath=/api/auth/slack/callback

# ----------------------------------------------------------
# Dev3 — Vínculos de identidad (opcional, para tests de autorización)
# ----------------------------------------------------------
# Descomentar y completar con datos REALES tras hacer login con Dropbox/Microsoft
# y obtener el IdentificadorExterno del campo "id" en /api/auth/me
# Dev3__VinculosIdentidad__0__Proveedor=Dropbox
# Dev3__VinculosIdentidad__0__IdentificadorExterno=IDENTIFICADOR_EXTERNO_REAL
# Dev3__VinculosIdentidad__0__UsuarioId=GUID_LOCAL_REAL
# Dev3__VinculosIdentidad__1__Proveedor=Microsoft
# Dev3__VinculosIdentidad__1__IdentificadorExterno=EMISOR_REAL|SUB_REAL
# Dev3__VinculosIdentidad__1__UsuarioId=GUID_LOCAL_REAL
